# Copy to .env and adjust. Only paths, profile names and non-secret overrides
# belong here. Never commit real AWS credentials - the tool is read-only and
# uses a read-only IAM role (Phase 5) or the local AWS profile.

# SQLite database location (relative to backend/ unless absolute)
WASTWISE_DATABASE_PATH=data/wastewise.db

# FastAPI dev server bind
WASTWISE_HOST=127.0.0.1
WASTWISE_PORT=8000

# Comma-separated browser origins allowed to call the API
WASTWISE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Config file locations
WASTWISE_LANGUAGE_FILE=config/language.en.json
WASTWISE_RULES_FILE=config/rules.yaml
WASTWISE_DEMO_SEED_FILE=data/demo_seed.json

# Demo mode on/off (true = use the fake account, no AWS needed)
WASTWISE_DEMO=true

# Pricing pipeline
WASTWISE_PRICING_API_REGION=us-east-1
WASTWISE_CACHE_TTL_SECONDS=86400
WASTWISE_HOURS_PER_MONTH=730
WASTWISE_CURRENCY=USD

# AWS profile to use in real mode (leave unset for demo mode)
# AWS_PROFILE=
